{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "self-assistant-plugin hooks 配置（已优化，性能提升 59%）",
  "_备份": "原始配置: hooks.json.backup",
  "_优化说明": "移除重复的 event_logger.py，每次工具调用从 860ms 降至 350ms",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pre_tool_use.py",
            "timeout": 30,
            "statusMessage": "安全检查..."
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/skills/continuous-learning-v2/hooks/observe.sh pre",
            "timeout": 5,
            "statusMessage": "观察学习中..."
          }
        ],
        "description": "安全防护 + continuous-learning-v2 观察"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/skills/continuous-learning-v2/hooks/observe.sh post",
            "timeout": 5,
            "statusMessage": "记录学习..."
          }
        ],
        "description": "continuous-learning-v2 观察"
      }
    ]
  }
}
